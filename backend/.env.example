# PostgreSQL (local hoặc Neon/Supabase). Ví dụ local:
DATABASE_URL="postgresql://tokenforge:tokenforge@localhost:5432/tokenforge?schema=public"

# RPC Sepolia (có thể dùng lại URL Infura của contracts)
RPC_URL="https://sepolia.infura.io/v3/<INFURA_API_KEY>"

TOKEN_ADDRESS="0x4D7b251399E5B8Db210Ad2C722B48c6c3A07f795"
DEPLOY_BLOCK=11956531

PORT=4000
# Origin của frontend (Vite dev). Nhiều origin: phân cách bằng dấu phẩy
CORS_ORIGIN="http://localhost:5173"

# Indexer
RUN_INDEXER=true          # chạy indexer chung process với API
CONFIRMATIONS=6           # chỉ index block đã có >= N xác nhận (tránh reorg)
BATCH_SIZE=2000           # số block mỗi lần eth_getLogs
POLL_INTERVAL_MS=12000
