{
  "name": "tokenforge-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TokenForge backend: REST API + event indexer (Express, Prisma, PostgreSQL, ethers)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "indexer": "tsx src/indexer/run.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "ethers": "^6.17.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.20.5",
    "prisma": "^6.19.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
